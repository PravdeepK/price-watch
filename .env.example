# Copy to .env and fill in. Keep .env private (chmod 600); it is not in git.

# Your Price Watch ntfy topic. Anyone who knows it can read it, so keep it long and random.
NTFY_TOPIC=pricewatch-replace-me
# NTFY_SERVER=https://ntfy.sh

# Used in notifications to link back to the web page, for example
# http://raspberrypi.local:5000 or your own private hostname.
PW_BASE_URL=http://localhost:5000

# Read-only share page (see share.py). Blank token turns sharing off.
# If you turn it on, set PW_SHARE_BASE_URL to the public address that reaches
# PW_SHARE_PORT. Change the token to make old links stop working.
PW_SHARE_TOKEN=
PW_SHARE_BASE_URL=
# PW_SHARE_PORT=5001

# Optional login for the web page. Leave blank for no login.
PW_USER=
PW_PASSWORD=

# Canadian Tire store for prices and stock. Required for Canadian Tire items.
# Find a store's number at the end of its page address on canadiantire.ca/en/store-details/...
CT_STORE_ID=

# Canadian Tire's public web API key (sent by canadiantire.ca itself). Optional
# for product checks: if blank, the key is read from the product page. Needed
# for Canadian Tire search results.
CT_API_KEY=
