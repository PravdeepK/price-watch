[Unit]
Description=Price Watch web page (home network, port 5000)
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/opt/price-watch
EnvironmentFile=/opt/price-watch/.env
ExecStart=/opt/price-watch/.venv/bin/waitress-serve --listen=0.0.0.0:5000 --threads=4 app:app
Restart=always
RestartSec=10
# Keep a runaway check from starving Pi-hole and the Cineplex bot.
MemoryMax=800M

[Install]
WantedBy=multi-user.target
